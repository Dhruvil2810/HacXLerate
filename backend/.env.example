# ==============================================================================
# CreatorOS — Backend Environment Configuration Template
# ==============================================================================

# Server Environment (Render automatically injects PORT, e.g. 10000)
PORT=5000
NODE_ENV=production
# URL of your Render Static Site frontend (e.g., https://creatoros-frontend.onrender.com)
FRONTEND_URL=https://your-frontend-subdomain.onrender.com
# URL of your Render Web Service backend (e.g., https://creatoros-api.onrender.com)
BACKEND_URL=https://your-backend-api-subdomain.onrender.com
# Allowed CORS origins (comma-separated if multiple, e.g., https://your-frontend.onrender.com)
CORS_ORIGIN=https://your-frontend-subdomain.onrender.com

# Database (Neon PostgreSQL with TLS/SSL required)
# Format for Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_your_neon_password@ep-your-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security & Authentication (JWT - Generate random 64-character hex strings in production)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # Exactly 32 bytes (64 hex characters) for AES-256-GCM

# Google OAuth (For User Sign-In / Sign-Up)
# Update callback URL to match your Render backend domain
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-api-subdomain.onrender.com/api/v1/auth/google/callback

# YouTube OAuth & Data API (For Creator Channel Verification)
# Update redirect URI to match your Render backend domain
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=https://your-backend-api-subdomain.onrender.com/api/v1/social/youtube/callback
YOUTUBE_API_KEY=your_optional_youtube_server_api_key

# OpenRouter AI Provider (Free-tier models: google/gemma-2-9b-it:free, mistralai/mistral-7b-instruct:free, openrouter/free)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=google/gemma-2-9b-it:free
OPENROUTER_SITE_URL=https://your-frontend-subdomain.onrender.com
OPENROUTER_SITE_NAME=CreatorOS

# Internal Credits Pricing & Configuration
AI_DEFAULT_CREDIT_COST=10
DEFAULT_STARTING_CREDITS_BRAND=5000
DEFAULT_STARTING_CREDITS_CREATOR=500

# Matching Engine Default Statistical Weights (Must sum to 1.0)
MATCH_AUDIENCE_WEIGHT=0.30
MATCH_CONTENT_WEIGHT=0.25
MATCH_PERFORMANCE_WEIGHT=0.20
MATCH_ENGAGEMENT_WEIGHT=0.10
MATCH_HISTORY_WEIGHT=0.10
MATCH_BUDGET_WEIGHT=0.05
