# ==============================================================================
# CreatorOS — Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://creatoros_user:creatoros_secure_password@localhost:5432/creatoros_db?schema=public

# Security & Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 32 bytes hex for AES-256-GCM

# Google OAuth (For User Sign-In / Sign-Up)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# YouTube OAuth & Data API (For Creator Social Connection)
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/v1/social/youtube/callback
YOUTUBE_API_KEY=your_optional_youtube_server_api_key

# OpenRouter AI Provider
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=CreatorOS

# Internal Credits Pricing & Configuration
AI_DEFAULT_CREDIT_COST=10
DEFAULT_STARTING_CREDITS_BRAND=5000
DEFAULT_STARTING_CREDITS_CREATOR=500

# Matching Engine Default Weights (Must sum to 1.0)
MATCH_AUDIENCE_WEIGHT=0.30
MATCH_CONTENT_WEIGHT=0.25
MATCH_PERFORMANCE_WEIGHT=0.20
MATCH_ENGAGEMENT_WEIGHT=0.10
MATCH_HISTORY_WEIGHT=0.10
MATCH_BUDGET_WEIGHT=0.05
